# ===== Controle Normativo — configuração =====
# Copie para ".env" e preencha. Nunca versione o .env.

# Endereço público do sistema. No Railway é preenchido sozinho (pode deixar vazio).
BASE_URL=https://normas.suaempresa.com.br
PORT=3000
# true quando estiver atrás de proxy reverso/balanceador que termina o HTTPS
TRUST_PROXY=true

# Banco PostgreSQL (com docker compose, a URL é montada automaticamente a partir de POSTGRES_PASSWORD)
DATABASE_URL=postgres://controle_normativo:SENHA@servidor-banco:5432/controle_normativo
DATABASE_SSL=false
POSTGRES_PASSWORD=troque-esta-senha

# Segredo das sessões (opcional). Vazio = gerado automaticamente e guardado no banco.
SESSION_SECRET=
SESSAO_HORAS=8

# ----- Login -----
# local = e-mail e senha cadastrados no próprio sistema (padrão)
# entra = Microsoft Entra ID (login corporativo)
# dev   = sem senha, só para teste no próprio computador
AUTH_MODE=local

# Primeiro administrador (AUTH_MODE=local). Usado só enquanto não existir nenhum Admin.
# A senha provisória precisa ter 10+ caracteres; a troca é exigida no primeiro acesso.
ADMIN_EMAIL=
ADMIN_SENHA_INICIAL=
ADMIN_NOME=Administrador

# ----- Microsoft Entra ID (AUTH_MODE=entra) -----
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Perfis: o recomendado é usar as App Roles "Admin", "Analista" e "Leitura" (veja o README).
# Alternativa: IDs (Object ID) de grupos do Entra ID
ENTRA_GRUPO_ADMIN=
ENTRA_GRUPO_ANALISTA=
ENTRA_GRUPO_LEITURA=
# true = quem não tiver perfil atribuído não entra
ENTRA_EXIGIR_PERFIL=true

# Somente com AUTH_MODE=dev
DEV_USUARIO_NOME=Usuário de teste
DEV_USUARIO_PERFIL=Admin

# ----- Evidências -----
# banco = arquivos guardados no PostgreSQL (padrão, não precisa de disco) | disco = pasta UPLOAD_DIR
ARMAZENAMENTO=banco
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# ----- Captura diária de normas (Banco Central, CVM, ANBIMA) -----
CAPTURA_ATIVA=true
# minuto hora dia mês dia-da-semana (padrão: todo dia às 07:35)
CAPTURA_CRON=35 7 * * *
CAPTURA_FUSO=America/Sao_Paulo
CAPTURA_ANBIMA=true
# Se o banco estiver vazio, busca a partir desta data (padrão: últimos 30 dias)
CAPTURA_DATA_INICIAL=

# Carrega as normas do piloto (dados/backup-...) na primeira inicialização, se o banco estiver vazio
IMPORTAR_DADOS_PILOTO=false

# Proxy corporativo para a saída à internet (se houver)
# HTTPS_PROXY=http://proxy.suaempresa:8080
# NO_PROXY=localhost,127.0.0.1,servidor-banco
