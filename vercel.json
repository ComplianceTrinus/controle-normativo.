{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "static-vazio",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{public,db,dados}/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/captura", "schedule": "35 10 * * *" },
    { "path": "/api/cron/email", "schedule": "30 11 * * 1-5" }
  ]
}
